{
  "name": "blockdiag",
  "version": "0.1.0",
  "description": "A TypeScript successor to blockdiag, a text-to-diagram generator for block diagrams.",
  "type": "module",
  "bin": {
    "blockdiag": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor/vlgothic",
    "skill"
  ],
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tk0miya/blockdiag-ng.git"
  },
  "bugs": "https://github.com/tk0miya/blockdiag-ng/issues",
  "homepage": "https://github.com/tk0miya/blockdiag-ng#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ci": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run ci"
  },
  "keywords": [
    "blockdiag",
    "diagram",
    "svg",
    "png",
    "cli"
  ],
  "author": "Takeshi Komiya",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/color-name": "^2.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "color-name": "^2.1.1",
    "fontkit": "^2.0.4"
  }
}
